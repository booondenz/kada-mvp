# 复制成 .env 后按需修改：cp .env.example .env
#
# 这个文件是**模板**，里面没有任何真实密钥。原项目有一条很疼的教训写在这里：
# 一个"看起来像配置好了"的示例值（比如把 SMS_SIGN_NAME 填成 kada）会让
# "没有配置"这件事在启动时完全看不出来，最后表现为一个读起来像账号故障的报错。
# 所以凡是没配就该留空，让缺配置在日志里说得清清楚楚。

# ---- 基础 ----
PORT=8080
GIN_MODE=debug
# release 模式下 JWT_SECRET 是弱密钥会直接拒绝启动
# 生成一个强密钥：openssl rand -hex 32
JWT_SECRET=kada-dev-secret-change-in-production
JWT_EXPIRES_IN=720h

# ---- PostgreSQL ----
# 对应 docker-compose.yml 里的默认账号
DATABASE_URL=postgres://kada:kada123@localhost:5432/kada?sslmode=disable
# 让 API 启动时自动补齐表结构。生产环境建议 false，由 cmd/migrate 显式执行，
# 这样"重启一次服务"永远不会顺手改数据库。
DB_AUTO_MIGRATE=true

# ---- Redis（可选）----
# 缓存和限流都"失败即放行"：Redis 挂了服务照常跑，只是没有缓存、限流暂时不拦。
REDIS_URL=redis://localhost:6379

# ---- 短链 ----
API_BASE_URL=https://kada.link
FRONTEND_URL=http://localhost:3000

# ---- Kafka（可选）----
# 留空 = 没有 Kafka：点击事件直接写库（降级模式）。
# 填了之后 cmd/server 会把点击发布到 topic，由 cmd/worker 消费落库。
KAFKA_BROKERS=
KAFKA_TOPIC=clicks
